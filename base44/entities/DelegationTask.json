{
  "name": "DelegationTask",
  "type": "object",
  "title": "Delegation Task",
  "properties": {
    "session_id": { "type": "string" },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "description": { "type": "string", "maxLength": 2000 },
    "risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "recoverability": { "type": "string", "enum": ["low", "medium", "high"] },
    "executor": { "type": "string", "enum": ["ai", "shared", "human"] },
    "permission": { "type": "string", "enum": ["not_required", "ask_first", "required"] },
    "status": { "type": "string", "enum": ["pending", "waiting_human", "running", "completed", "stopped", "undone"], "default": "pending" },
    "order": { "type": "integer", "minimum": 1 },
    "depends_on": { "type": "array", "items": { "type": "integer" }, "default": [] }
  },
  "required": ["session_id", "title", "risk", "executor", "status"],
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}

