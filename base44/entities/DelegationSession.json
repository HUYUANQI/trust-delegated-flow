{
  "name": "DelegationSession",
  "type": "object",
  "title": "Delegation Session",
  "properties": {
    "goal": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "status": { "type": "string", "enum": ["draft", "analyzing", "planned", "awaiting_approval", "running", "completed", "stopped", "undone"], "default": "draft" },
    "task_summary": { "type": "string", "maxLength": 4000 },
    "expected_outcome": { "type": "string", "maxLength": 4000 },
    "overall_risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "ai_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "recoverability": { "type": "string", "enum": ["low", "medium", "high"] },
    "difficulty_score": { "type": "number", "minimum": 1, "maximum": 5 },
    "delegation_mode": { "type": "string", "enum": ["human", "shared", "ai"], "default": "shared" },
    "accepted": { "type": "boolean", "default": false },
    "analysis": { "type": "object" }
  },
  "required": ["goal", "status"],
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}

