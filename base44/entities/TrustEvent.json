{
  "name": "TrustEvent",
  "type": "object",
  "title": "Trust Event",
  "properties": {
    "session_id": { "type": "string" },
    "dimension": { "type": "string", "enum": ["automation_confidence", "user_confidence", "recovery_reliability", "human_intervention", "permission_accuracy"] },
    "delta": { "type": "number", "minimum": -100, "maximum": 100 },
    "reason": { "type": "string", "maxLength": 2000 },
    "positive": { "type": "boolean" }
  },
  "required": ["dimension", "delta", "reason"],
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}

